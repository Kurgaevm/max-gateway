# Админ-ключ шлюза: управление инстансами и доступ ко всем операциям
# Сгенерировать: openssl rand -hex 24
MAXGW_API_KEY=change-me

# Глобальный вебхук для входящих сообщений (используется, если у инстанса не задан свой)
MAXGW_WEBHOOK_URL=

# Телефон по умолчанию для инстанса default (необязательно, можно ввести в веб-интерфейсе)
MAXGW_PHONE=

# Имя для авто-регистрации нового аккаунта MAX при первом входе
MAXGW_REG_FIRST=Salon
MAXGW_REG_LAST=Bot

# Telegram-инстансы: api_id/api_hash своего приложения
# Создаётся один раз на https://my.telegram.org/apps (My Core -> API development tools)
TG_API_ID=
TG_API_HASH=

# Расшифровка голосовых сообщений (OpenAI-совместимый endpoint), например:
# STT_BASE_URL=https://api.openai.com/v1/audio/transcriptions
# STT_API_KEY=sk-...
# STT_MODEL=whisper-1
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
